:root { --background: 39 38% 95%; --foreground: 167 30% 15%; --card: 42 43% 98%; --card-foreground: 167 30% 15%; --popover: 42 43% 98%; --popover-foreground: 167 30% 15%; --primary: 165 43% 25%; --primary-foreground: 42 43% 98%; --secondary: 38 41% 89%; --secondary-foreground: 167 30% 15%; --muted: 39 27% 89%; --muted-foreground: 166 11% 42%; --accent: 30 69% 52%; --accent-foreground: 24 42% 13%; --destructive: 7 55% 42%; --destructive-foreground: 42 43% 98%; --border: 37 25% 82%; --input: 37 25% 82%; --ring: 30 69% 52%; --radius: 0.7rem; --app-font-sans: 'Manrope', sans-serif; --app-font-serif: 'Newsreader', serif; --app-font-mono: 'DM Mono', monospace; --sidebar: 165 43% 25%; --sidebar-foreground: 41 37% 91%; --sidebar-accent: 165 37% 31%; --sidebar-border: 165 27% 35%; }

.dark { --background: 166 25% 11%; --foreground: 40 35% 92%; --card: 166 23% 15%; --card-foreground: 40 35% 92%; --popover: 166 23% 15%; --popover-foreground: 40 35% 92%; --primary: 38 70% 57%; --primary-foreground: 166 25% 11%; --secondary: 165 24% 23%; --secondary-foreground: 40 35% 92%; --muted: 165 18% 24%; --muted-foreground: 40 13% 68%; --accent: 30 69% 52%; --accent-foreground: 24 42% 13%; --destructive: 7 62% 58%; --destructive-foreground: 40 35% 92%; --border: 165 15% 28%; --input: 165 15% 28%; --ring: 30 69% 52%; --sidebar: 166 27% 9%; --sidebar-foreground: 40 35% 92%; --sidebar-accent: 165 24% 18%; --sidebar-border: 165 15% 23%; }

.auth-page { min-height: 100dvh; display: grid; place-items: center; padding: 24px; background: hsl(var(--background)); }

.auth-landing { min-height: 100dvh; display: grid; place-items: center; padding: 24px; background: radial-gradient(circle at 15% 12%, hsl(30 69% 52% / 0.14), transparent 28rem), hsl(var(--background)); }

.auth-landing-card { width: min(100%, 510px); padding: 42px; border: 1px solid hsl(var(--border)); border-radius: 1rem; background: hsl(var(--card)); box-shadow: rgba(27, 50, 45, 0.08) 0px 24px 60px; }

.auth-landing-card h1 { margin: 26px 0px 10px; font-family: var(--app-font-serif); font-size: clamp(42px, 8vw, 68px); line-height: 0.96; letter-spacing: -0.045em; }

.auth-landing-card p { max-width: 410px; margin: 0px 0px 24px; color: hsl(var(--muted-foreground)); font-size: 14px; line-height: 1.7; }

.auth-landing-note { margin-top: 16px; color: hsl(var(--muted-foreground)); font-family: var(--app-font-mono); font-size: 10px; line-height: 1.5; }

@layer base {
  * { border-color: hsl(var(--border)); }
  html { background: hsl(var(--background)); }
  body { background-color: hsl(var(--background)); font-family: var(--app-font-sans); color: hsl(var(--foreground)); -webkit-font-smoothing: antialiased; margin: 0px; }
  button, input, select { font: inherit; }
}

@keyframes rise-in { 
  0% { opacity: 0; transform: translateY(7px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes slide-in { 
  0% { opacity: 0; transform: translateX(-8px); }
  100% { opacity: 1; transform: translateX(0px); }
}

@keyframes pulse-soft { 
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

.app-shell { min-height: 100dvh; display: flex; background: hsl(var(--background)); }

.sidebar { width: 248px; flex: 0 0 248px; background: hsl(var(--sidebar)); color: hsl(var(--sidebar-foreground)); padding: 25px 17px; display: flex; flex-direction: column; }

.brand-mark { display: flex; align-items: center; gap: 11px; padding: 0px 10px 28px; }

.brand-symbol { width: 33px; height: 33px; border: 1px solid rgba(215, 184, 127, 0.55); border-radius: 9px 9px 9px 2px; transform: rotate(-8deg); display: grid; place-items: center; color: rgb(235, 182, 96); }

.brand-name { font-size: 16px; line-height: 1.05; font-weight: 800; letter-spacing: 0.13em; }

.brand-sub { display: block; margin-top: 4px; color: rgb(198, 188, 169); font-size: 9px; text-transform: uppercase; letter-spacing: 0.16em; }

.nav-label { color: rgb(186, 178, 160); font: 10px var(--app-font-mono); text-transform: uppercase; letter-spacing: 0.13em; padding: 9px 12px 8px; }

.nav-link { display: flex; align-items: center; gap: 11px; padding: 11px 12px; margin: 3px 0px; border-radius: 8px; color: rgb(213, 205, 190); font-size: 13px; text-decoration: none; transition: background 0.18s, color 0.18s, transform 0.18s; }

.nav-link:hover { background: hsl(var(--sidebar-accent)); color: rgb(250, 248, 245); transform: translateX(2px); }

.nav-link.active { background: rgb(226, 166, 70); color: rgb(26, 66, 56); font-weight: 800; }

.sidebar-foot { margin-top: auto; border-top: 1px solid hsl(var(--sidebar-border)); padding: 17px 11px 2px; }

.sync-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: rgb(180, 206, 115); margin-right: 7px; box-shadow: rgba(180, 206, 115, 0.12) 0px 0px 0px 3px; }

.main-area { min-width: 0px; flex: 1 1 0%; }

.topbar { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid hsl(var(--border)); padding: 0px 36px; background: hsl(var(--background) / .85); backdrop-filter: blur(12px); position: sticky; top: 0px; z-index: 10; }

.eyebrow { font: 10px var(--app-font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: hsl(var(--muted-foreground)); }

.role-switch { display: inline-flex; align-items: center; gap: 4px; border: 1px solid hsl(var(--border)); background: hsl(var(--card)); border-radius: 8px; padding: 3px; }

.role-button { border: 0px; color: hsl(var(--muted-foreground)); background: transparent; padding: 7px 12px; border-radius: 5px; cursor: pointer; font-size: 12px; font-weight: 700; transition: 0.18s; }

.role-button.active { background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); box-shadow: rgba(36, 91, 77, 0.18) 0px 2px 4px; }

.page { max-width: 1440px; margin: 0px auto; padding: 34px 36px 52px; animation: 0.38s ease 0s 1 normal both running rise-in; }

.page-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 29px; }

.page-heading h1 { font: 600 clamp(29px, 3vw, 40px)/1.02 var(--app-font-serif); letter-spacing: -0.03em; margin: 6px 0px 8px; }

.page-heading p { color: hsl(var(--muted-foreground)); margin: 0px; font-size: 13px; }

.section-title { font-size: 13px; font-weight: 800; letter-spacing: 0.01em; margin: 0px; }

